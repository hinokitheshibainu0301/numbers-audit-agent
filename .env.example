# ── Required ────────────────────────────────────────────────────────
# Your Numbers Protocol Capture API token
# Get it from: https://captureapp.xyz
CAPTURE_TOKEN=your_capture_token_here

# Your Capture wallet address
CAPTURE_WALLET=your_wallet_address_here

# ── Agent Identity ───────────────────────────────────────────────────
# Set after first run to skip registration on future runs
# Leave blank on first run — the agent will guide you through setup
AGENT_NID=

# Display name for your agent (used as headline on Numbers Mainnet)
# Will be prompted on first run if AGENT_NID is not set
AGENT_NAME=Numbers Audit Agent

# ── API Endpoints ────────────────────────────────────────────────────
# Defaults are pre-configured — only override if needed
PYRO_API_URL=https://us-central1-pyroimage-x402.cloudfunctions.net/fetchPyroAssets
PYRO_ORG_ID=f3bdb752-cd59-43f3-ace9-ec7b021fa772
DIA_BACKEND_URL=https://dia-backend.numbersprotocol.io/api/v3
COMMIT_API_URL=https://us-central1-numbers-protocol-api.cloudfunctions.net/nit-commit-to-jade
REGISTRATION_API_URL=https://api.numbersprotocol.io/api/v3/assets/

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO